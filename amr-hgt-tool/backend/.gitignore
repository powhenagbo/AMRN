# Runtime data generated by app.py — never commit
uploads/
genomes/
results/
jobs_store.json

# Caches populated at runtime
structure_cache/
ontology_cache/

# Panel build scratch work
panel/*/_build_work/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS cruft
.DS_Store
